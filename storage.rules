rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Signatures for salary receipt acknowledgments
    match /signatures/salaries/{signatureFile} {
      allow read: if request.auth != null;
      // Authenticated teachers can upload their signature image (max 2MB, image MIME type only)
      allow write: if request.auth != null 
        && request.resource.size < 2 * 1024 * 1024 
        && request.resource.contentType.matches('image/.*');
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
